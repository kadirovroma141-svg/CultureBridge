# Copy to .env and fill in. Never commit .env.

# Flask session signing key — REQUIRED in production (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me
# Set to true when served over HTTPS (Render / Railway do this)
SESSION_COOKIE_SECURE=false

# Database: SQLite by default (culturebridge.db in the project root).
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/culturebridge
DATABASE_URL=

# AI engine: gemini | openai | none
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: gemini-2.5-flash / gpt-4o-mini)
AI_MODEL=
AI_TIMEOUT=15
# Max /api/decode requests per minute per IP (0 = unlimited)
DECODE_RATE_LIMIT=20

# Admin panel at /admin (disabled when empty)
ADMIN_PASSWORD=

# Seed an empty database automatically on startup
AUTO_SEED=true

# --- Vercel + Supabase -------------------------------------------------------------------------------
# Use the Supabase *pooler* string (Connect → Transaction pooler, port 6543): the direct db.<ref>.supabase.co
# host is IPv6-only and unreachable from Vercel. URL-encode special characters in the password (@ → %40).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# On Vercel (VERCEL=1 is set automatically) AUTO_SEED and AUTO_MIGRATE default to false: run `python seed.py`
# locally against the same DATABASE_URL once, and again after schema changes.
# AUTO_MIGRATE=true
